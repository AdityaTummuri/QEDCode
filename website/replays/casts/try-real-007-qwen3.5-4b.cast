[14.825748, "o", "Tries: c1: grade A\r\n"]
[14.826094, "o", "\r\nThe original code sorted scores in ascending order, so the lowest values appeared first. The change adds \r\n`\u001b[33mreverse\u001b[0m=\u001b[3;92mTrue\u001b[0m` to sort them descending, placing the highest scores at the front. This now correctly returns \r\nthe top three scores from best to worst as intended.\r\n"]
[14.826193, "o", "\r\nThe change:\r\n"]
[14.82679, "o", "diff --git a/src/board/scores.py b/src/board/scores.py\r\nindex 5a14ce2..ffc4f0c 100644\r\n--- a/src/board/scores.py\r\n+++ b/src/board/scores.py\r\n@@ -3,7 +3,7 @@\r\n \r\n def top_scores(scores, n=3):\r\n     \"\"\"Return the n highest scores, best first.\"\"\"\r\n-    return sorted(scores)[:n]\r\n+    return sorted(scores, reverse=True)[:n]\r\n \r\n \r\n def best_score(scores):\r\ndiff --git a/tests/test_qed_top_scores_returns_the_lowest.py b/tests/test_qed_top_scores_returns_the_lowest.py\r\nnew file mode 100644\r\nindex 0000000..12aed74\r\n--- /dev/null\r\n+++ b/tests/test_qed_top_scores_returns_the_lowest.py\r\n@@ -0,0 +1,9 @@\r\n+from board.scores import top_scores\r\n+\r\n+\r\n+def test_top_scores_order():\r\n+    assert top_scores([1, 2, 3]) == [3, 2, 1]\r\n+\r\n+\r\n+def test_top_scores_with_n():\r\n+    assert top_scores([1, 2, 3, 4], n=2) == [4, 3]\r\n"]
[14.826973, "o", "\r\n$ qed verify \u001b[1m<\u001b[0m\u001b[1;95mreceipt\u001b[0m\u001b[1m>\u001b[0m\r\n"]
[14.827076, "o", "\u001b[1;32mVERIFIED\u001b[0m\r\n"]
