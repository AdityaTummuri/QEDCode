[15.982333, "o", "Tries: c1: grade A\r\n"]
[15.982613, "o", "\r\nThe original code crashed because it tried to access the first character of an empty line, which caused an \r\nerror. The fix adds a check at the start to return an empty list immediately if the line is empty or contains \r\nonly spaces. This prevents the crash and ensures that empty input always results in a clean, empty output.\r\n"]
[15.982692, "o", "\r\nThe change:\r\n"]
[15.983255, "o", "diff --git a/src/csvlite/parser.py b/src/csvlite/parser.py\r\nindex 671c25c..1657a7b 100644\r\n--- a/src/csvlite/parser.py\r\n+++ b/src/csvlite/parser.py\r\n@@ -4,6 +4,8 @@\r\n def parse_csv_line(line):\r\n     \"\"\"Split one CSV line into trimmed fields. Lines starting with # are comments.\"\"\"\r\n     line = line.strip()\r\n+    if not line:\r\n+        return []\r\n     if line[0] == \"#\":\r\n         return []\r\n     return [field.strip() for field in line.split(\",\")]\r\ndiff --git a/tests/test_qed_parse_csv_line_crashes_with.py b/tests/test_qed_parse_csv_line_crashes_with.py\r\nnew file mode 100644\r\nindex 0000000..4f05c3b\r\n--- /dev/null\r\n+++ b/tests/test_qed_parse_csv_line_crashes_with.py\r\n@@ -0,0 +1,13 @@\r\n+from csvlite.parser import parse_csv_line\r\n+\r\n+\r\n+def test_empty_string_returns_empty_list():\r\n+    \"\"\"Test that an empty string returns an empty list without crashing.\"\"\"\r\n+    result = parse_csv_line(\"\")\r\n+    assert result == []\r\n+\r\n+\r\n+def test_whitespace_only_returns_empty_list():\r\n+    \"\"\"Test that whitespace-only strings return an empty list without crashing.\"\"\"\r\n+    result = parse_csv_line(\"   \")\r\n+    assert result == []\r\n"]
[15.983421, "o", "\r\n$ qed verify \u001b[1m<\u001b[0m\u001b[1;95mreceipt\u001b[0m\u001b[1m>\u001b[0m\r\n"]
[15.983485, "o", "\u001b[1;32mVERIFIED\u001b[0m\r\n"]
[15.983538, "o", "\r\nNext steps:\r\n"]
[15.983666, "o", "  qed check    in your own repository: grade what you or your agent changed \u001b[1m(\u001b[0mno model\u001b[1m)\u001b[0m\r\n"]
